{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hassanj-dev",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "portfolio.phons.dev", "custom_domain": true },
    { "pattern": "hassanj.dev", "custom_domain": true },
    { "pattern": "www.hassanj.dev", "custom_domain": true }
  ]
}
