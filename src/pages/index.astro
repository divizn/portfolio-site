---
import { getCollection } from "astro:content";
import { FiArrowRight } from "solid-icons/fi";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Timeline } from "@/components/Timeline";
import { GraphPaper } from "@/components/GraphPaper";
import { BentoGrid, BentoGridItem, Separator } from "@ph0n/theme-kit/ui";
import { experience } from "@/constants/experience";
import { education } from "@/constants/education";

const allProjects = await getCollection(
  "projects",
  ({ data }) => data.published,
);
const featured = allProjects
  .filter((project) => project.data.featured)
  .sort(
    (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
  );
---

<BaseLayout title="Hassan" description="My portfolio.">
  <div class="relative">
    <GraphPaper class="absolute inset-x-0 top-0 h-[30rem]" client:idle />
    <main class="relative mx-auto max-w-4xl px-6 py-24">
      <section>
        <h1
          class="font-display animate-ink text-4xl text-accent text-shadow-[0_0_20px_var(--glow-a),0_0_50px_var(--glow-b)] sm:text-5xl"
        >
          <span class="relative inline-block">
            Hassan Javed
            <svg
              viewBox="0 0 100 10"
              preserveAspectRatio="none"
              aria-hidden="true"
              class="animate-underline absolute -bottom-[0.32em] -left-[2%] h-[0.4em] w-[104%] overflow-visible fill-none stroke-accent stroke-[2.5] [stroke-dasharray:1_2] [stroke-dashoffset:1.05] [stroke-linecap:round] motion-reduce:[stroke-dashoffset:0]"
            >
              <path pathLength="1" d="M1 6 C 20 2, 45 9, 70 4 S 95 5, 99 3"
              ></path>
            </svg>
          </span>
        </h1>
        <p class="animate-intro mt-6 max-w-xl text-muted-foreground">
          Scientific Computing Graduate at STFC UKRI, working on simulation
          software and backend systems. BSc Computer Science (First Class
          Honours), Brunel University London.
        </p>
      </section>

      <Separator class="my-12" />

      <section>
        <h2 class="font-display text-xl text-accent">Experience</h2>
        <Timeline items={experience} class="mt-6" client:visible />
      </section>

      <Separator class="my-12" />

      <section>
        <h2 class="font-display text-xl text-accent">Education</h2>
        <Timeline items={education} class="mt-6" client:visible />
      </section>

      <Separator class="my-12" />

      <section>
        <div class="flex items-baseline justify-between">
          <h2 class="font-display text-xl text-accent">Projects</h2>
          <a
            href="/projects"
            class="flex items-center gap-1.5 text-sm text-muted-foreground duration-200 hover:text-accent"
          >
            View all
            <FiArrowRight class="h-4 w-4" />
          </a>
        </div>
        <BentoGrid class="mt-6" client:visible>
          {
            featured.map((project, index) => (
              <BentoGridItem
                href={`/projects/${project.id}`}
                class={index >= 4 ? "hidden lg:block" : undefined}
                title={project.data.title}
              >
                {project.data.description}
              </BentoGridItem>
            ))
          }
        </BentoGrid>
      </section>
    </main>
  </div>
</BaseLayout>
