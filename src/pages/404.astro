---
import { FiArrowLeft } from "solid-icons/fi";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 | Hassan">
  <main class="mx-auto flex max-w-4xl flex-col items-center px-6 py-32 text-center">
    <h1 class="font-display text-4xl text-accent">404</h1>
    <p class="mt-4 text-muted-foreground">This page doesn't exist.</p>
    <a
      href="/"
      class="mt-6 flex items-center gap-1.5 text-sm text-muted-foreground duration-200 hover:text-accent"
    >
      <FiArrowLeft class="h-4 w-4" />
      Back home
    </a>
  </main>
</BaseLayout>
