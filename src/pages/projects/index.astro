---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BentoGrid, BentoGridItem } from "@/components/BentoGrid";
import { Badge } from "@/components/ui/badge";

const projects = (await getCollection("projects", ({ data }) => data.published)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
---

<BaseLayout title="Projects | hassanj.dev" description="Selected projects.">
  <main class="mx-auto max-w-4xl animate-fade-in px-6 py-24">
    <h1 class="font-display text-3xl text-zinc-100">Projects</h1>

    <BentoGrid class="mt-10">
      {
        projects.map((project) => (
          <a href={`/projects/${project.id}`} class="block">
            <BentoGridItem title={project.data.title} span={project.data.featured ? 2 : 1}>
              <p>{project.data.description}</p>
              {project.data.tags && project.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {project.data.tags.map((tag) => (
                    <Badge variant="outline">{tag}</Badge>
                  ))}
                </div>
              )}
            </BentoGridItem>
          </a>
        ))
      }
    </BentoGrid>
  </main>
</BaseLayout>
