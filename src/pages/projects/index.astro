---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ProjectsGrid } from "@/components/ProjectsGrid";

const projects = (await getCollection("projects", ({ data }) => data.published))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .map((project) => ({
    id: project.id,
    title: project.data.title,
    description: project.data.description,
    featured: project.data.featured,
    tags: project.data.tags,
  }));
---

<BaseLayout title="Projects | Hassan" description="Selected projects.">
  <main class="mx-auto max-w-4xl animate-fade-in px-6 py-24">
    <h1 class="font-display text-3xl text-accent">Projects</h1>

    <ProjectsGrid items={projects} class="mt-10" />
  </main>
</BaseLayout>
