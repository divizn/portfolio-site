---
import { getCollection, render } from "astro:content";
import { FiArrowLeft, FiExternalLink, FiGithub } from "solid-icons/fi";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.published);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, date, url, repository, tags } = project.data;
---

<BaseLayout title={`${title} | Hassan`} description={description}>
  <main>
    <div class="border-b border-border bg-gradient-to-tl from-background via-muted to-background">
      <div class="mx-auto max-w-3xl px-6 py-6">
        <a
          href="/projects"
          class="flex items-center gap-1.5 text-sm text-muted-foreground duration-200 hover:text-accent"
        >
          <FiArrowLeft class="h-4 w-4" />
          Back to projects
        </a>
      </div>
      <div class="mx-auto max-w-3xl px-6 pb-16 text-center">
        <h1 class="font-display text-3xl text-accent sm:text-5xl">{title}</h1>
        <p class="mt-4 text-muted-foreground">{description}</p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-sm">
          {
            date && (
              <time datetime={new Date(date).toISOString()} class="text-muted-foreground">
                {new Date(date).toLocaleDateString(undefined, { dateStyle: "medium" })}
              </time>
            )
          }
          {
            repository && (
              <a
                href={`https://github.com/${repository}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1.5 text-muted-foreground duration-200 hover:text-accent"
              >
                <FiGithub class="h-4 w-4" />
                GitHub
              </a>
            )
          }
          {
            url && (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1.5 text-muted-foreground duration-200 hover:text-accent"
              >
                <FiExternalLink class="h-4 w-4" />
                Website
              </a>
            )
          }
        </div>

        {
          tags && tags.length > 0 && (
            <div class="mt-6 flex flex-wrap justify-center gap-1.5">
              {tags.map((tag) => (
                <Badge variant="outline">{tag}</Badge>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <article class="prose mx-auto max-w-3xl px-6 py-16">
      <Content />
    </article>
  </main>
</BaseLayout>
