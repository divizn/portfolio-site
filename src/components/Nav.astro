---
const links = [
  { href: "/projects", label: "Projects" },
  { href: "/contact", label: "Contact" },
];
---

<header class="border-b border-zinc-900">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
    <a href="/" class="text-sm text-zinc-300 duration-200 hover:text-zinc-100">
      Hassan Javed
    </a>
    <ul class="flex items-center gap-4 text-sm text-zinc-500">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="duration-200 hover:text-zinc-200">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
