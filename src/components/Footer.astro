---
import { socials } from "@/constants/social";
---

<footer class="border-t border-zinc-900">
  <div
    class="mx-auto flex max-w-4xl flex-col items-center gap-4 px-6 py-10 text-sm text-zinc-400 sm:flex-row sm:justify-between"
  >
    <p>&copy; {new Date().getFullYear()} Hassan Javed</p>
    <ul class="flex gap-4">
      {
        socials.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="duration-200 hover:text-zinc-200"
            >
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
